{
  "name": "es-helpers",
  "version": "1.2.0",
  "description": "Reusable Node.js database and application helpers with selective subpath imports",
  "keywords": [
    "nodejs",
    "commonjs",
    "helpers",
    "utilities",
    "mysql",
    "postgres",
    "postgresql",
    "firestore",
    "filesystem",
    "encryption",
    "git"
  ],
  "author": "Sayed Ahad Abbas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thatsuperdev/es-helpers.git"
  },
  "bugs": {
    "url": "https://github.com/thatsuperdev/es-helpers/issues"
  },
  "homepage": "https://github.com/thatsuperdev/es-helpers#readme",
  "type": "commonjs",
  "main": "./index.js",
  "types": "./index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./app-utils": "./app-utils.js",
    "./encrypt": "./encrypt.js",
    "./file": "./file.js",
    "./firestore": "./firestore.js",
    "./git": "./git.js",
    "./location": "./location.js",
    "./mysql": "./mysql.js",
    "./postgres": {
      "types": "./postgres.d.ts",
      "require": "./postgres.js",
      "default": "./postgres.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "*.js",
    "*.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test"
  },
  "peerDependencies": {
    "axios": "^1.4.0",
    "bcrypt": "^6.0.0",
    "debug": "^4.3.4",
    "dotenv": "^16.0.0",
    "firebase-admin": "^11.5.0",
    "folder-zip": "0.0.5",
    "jsonwebtoken": "^9.0.0",
    "mysql2": "^3.3.4",
    "pg": "^8.11.0",
    "qs": "^6.11.0",
    "simple-git": "^3.19.1"
  },
  "peerDependenciesMeta": {
    "axios": { "optional": true },
    "bcrypt": { "optional": true },
    "debug": { "optional": true },
    "dotenv": { "optional": true },
    "firebase-admin": { "optional": true },
    "folder-zip": { "optional": true },
    "jsonwebtoken": { "optional": true },
    "mysql2": { "optional": true },
    "pg": { "optional": true },
    "qs": { "optional": true },
    "simple-git": { "optional": true }
  },
  "devDependencies": {
    "axios": "^1.4.0",
    "bcrypt": "^6.0.0",
    "debug": "^4.3.4",
    "dotenv": "^16.0.0",
    "firebase-admin": "^11.5.0",
    "folder-zip": "0.0.5",
    "jsonwebtoken": "^9.0.0",
    "mysql2": "^3.3.4",
    "pg": "^8.11.0",
    "qs": "^6.11.0",
    "simple-git": "^3.19.1"
  },
  "license": "ISC"
}
